{
    "name": "Robotarm Dev Environment (Headless)",
    "build": {
        "context": "..",
        "dockerfile": "Dockerfile"
    },
    "workspaceFolder": "/robotarm_firmware_lnx",
    "mounts": [
        // Repo root bind mount: colcon build/install/log stay on the host.
        "source=${localWorkspaceFolder},target=/robotarm_firmware_lnx,type=bind",
        "source=/etc/localtime,target=/etc/localtime,type=bind,ro",
        "source=/sys,target=/sys,type=bind",
        "source=/dev,target=/dev,type=bind",
        "source=/tmp/.X11-unix,target=/tmp/.X11-unix,type=bind"
    ],
    "runArgs": [
        "--privileged",
        "--net=host",
        "--ipc=host",
        "--cap-add=sys_nice",
        "--ulimit", "rtprio=99",
        "--ulimit", "memlock=-1",
        // fdcanusb; the container won't start if it isn't plugged in.
        "--device", "/dev/ttyACM0:/dev/ttyACM0"
    ],
    "remoteEnv": {
        "DISPLAY": "${localEnv:DISPLAY}"
    },
    "remoteUser": "root",
    "postCreateCommand": "git config --global --add safe.directory '*'",
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-iot.vscode-ros",
                "ms-vscode.cpptools",
                "ms-vscode.cmake-tools",
                "ms-vscode.cpptools-extension-pack",
                "redhat.vscode-xml",
                "redhat.vscode-yaml",
                "sanaajani.taskrunnercode"
            ]
        }
    }
}
