<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robotarm_mujoco_hardware</name>
  <version>0.0.0</version>
  <description>ros2_control hardware plugin of the robotarm MuJoCo simulation, based on mujoco_ros2_control</description>
  <maintainer email="ruben01egle@gmail.com">root</maintainer>
  <license>TODO: License declaration</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>hardware_interface</depend>
  <depend>mujoco_ros2_control</depend>
  <depend>mujoco_ros2_control_plugins</depend>
  <depend>pluginlib</depend>
  <depend>yaml_cpp_vendor</depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
    <hardware_interface plugin="${prefix}/robotarm_mujoco_hardware_plugins.xml"/>
    <mujoco_ros2_control_plugins plugin="${prefix}/servo_plugin.xml"/>
  </export>
</package>
