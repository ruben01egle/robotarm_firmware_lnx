<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robotarm_mujoco</name>
  <version>0.0.0</version>
  <description>MuJoCo simulation of the robotarm: URDF to MJCF conversion and a ros2_control bringup with effort interfaces</description>
  <maintainer email="ruben01egle@gmail.com">root</maintainer>
  <license>TODO: License declaration</license>

  <!-- converter (also run by the launch file) -->
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>python3-mujoco-pip</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>robotarm_description</exec_depend>
  <exec_depend>xacro</exec_depend>

  <!-- simulation bringup -->
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>mujoco_ros2_control</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>robotarm_bringup</exec_depend>
  <exec_depend>robotarm_controllers</exec_depend>
  <exec_depend>ros2controlcli</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <!-- push_test -->
  <exec_depend>builtin_interfaces</exec_depend>
  <exec_depend>controller_manager_msgs</exec_depend>
  <exec_depend>mujoco_ros2_control_msgs</exec_depend>
  <exec_depend>mujoco_ros2_control_plugins</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>

  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>pinocchio</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
